{
  "name": "@tsdevstack/cli-mcp",
  "version": "0.5.0",
  "description": "MCP server for tsdevstack CLI - exposes tools and resources to AI agents",
  "author": "tsdevstack",
  "private": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsdevstack/cli-mcp.git"
  },
  "homepage": "https://github.com/tsdevstack/cli-mcp",
  "bugs": {
    "url": "https://github.com/tsdevstack/cli-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tsdevstack",
    "ai-agents",
    "claude",
    "infrastructure",
    "devops",
    "cli"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "format": "prettier --write .",
    "lint": "eslint .",
    "tsc": "tsc --noEmit",
    "test": "rstest run",
    "test:watch": "rstest --watch"
  },
  "peerDependencies": {
    "@tsdevstack/cli": ">=0.1.0",
    "commander": "^15.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rslib/core": "^0.23.2",
    "@rstest/adapter-rslib": "^0.11.4",
    "@rstest/core": "^0.11.4",
    "@types/node": "^22.19.17",
    "eslint": "^10.7.0",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.63.0"
  }
}
